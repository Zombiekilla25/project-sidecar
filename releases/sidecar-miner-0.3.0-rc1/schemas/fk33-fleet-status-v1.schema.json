{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fk33-fleet-status-v1",
  "title": "Project Sidecar public-safe FK33 fleet status",
  "type": "object",
  "required": ["schema", "rollout_stage", "fleet", "scheduler", "performance", "recent_failures", "cards", "hardware_access"],
  "properties": {
    "schema": {"const": "sidecar-fk-fleet-status-v1"},
    "rollout_stage": {"enum": ["CANARY_1", "EXPAND_2", "EXPAND_4", "FULL_8"]},
    "stage_aborted": {"type": "boolean"},
    "stage_abort_reason": {"type": ["string", "null"]},
    "fleet": {"type": "object"},
    "scheduler": {"type": "object"},
    "performance": {"type": "object"},
    "recent_failures": {"type": "array"},
    "cards": {"type": "array", "minItems": 1, "maxItems": 8},
    "hardware_access": {"const": "none"}
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fk0957-refusal-envelope-v1",
  "title": "FK0957 bounded refusal envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "phase", "code", "evidence_path", "signature_verified",
    "return_code", "target_candidates", "device_opened", "scan_a_started",
    "scan_a_tck_emitted", "scan_b_started", "scan_b_tck_emitted",
    "transport_closed", "permit_consumed", "operation_state",
    "close_from_state", "publication_state"
  ],
  "properties": {
    "status": { "const": "REFUSED" },
    "phase": {
      "enum": [
        "PRELIVE_VALIDATION", "PERMIT_VALIDATION", "LIBRARY_PROVENANCE",
        "FTDI_CONTEXT_CREATE", "REMOTE_BOOTSTRAP", "DEVICE_ENUMERATION",
        "DEVICE_SELECTION", "DEVICE_OPEN", "MPSSE_INIT", "SCAN_A_WRITE",
        "SCAN_A_READ", "SCAN_B_WRITE", "SCAN_B_READ", "TRANSPORT_CLOSE",
        "LOCAL_VALIDATION", "LOCAL_SIGNING", "INTERNAL_REFUSAL"
      ]
    },
    "code": {
      "enum": [
        "TRANSACTION_PIN_MISMATCH", "TRUSTED_LAUNCHER_REQUIRED", "PERMIT_INVALID",
        "DESCRIPTOR_STALE", "LIBRARY_PIN_MISMATCH", "FTDI_CONTEXT_FAILED",
        "REMOTE_BOOTSTRAP_FAILED", "ENUMERATION_FAILED", "NO_TARGET_CANDIDATE",
        "MULTIPLE_TARGET_CANDIDATES", "CANDIDATE_IDENTITY_MISMATCH",
        "DEVICE_OPEN_FAILED", "MPSSE_INIT_FAILED", "SCAN_A_WRITE_FAILED",
        "SCAN_A_READ_FAILED", "SCAN_B_WRITE_FAILED", "SCAN_B_READ_FAILED",
        "TRANSPORT_CLOSE_FAILED", "LOCAL_VALIDATION_FAILED", "LOCAL_SIGNING_FAILED",
        "INTERNAL_REFUSAL"
      ]
    },
    "evidence_path": { "const": "none" },
    "signature_verified": { "const": false },
    "return_code": { "type": ["integer", "null"], "minimum": -255, "maximum": 255 },
    "target_candidates": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 256 },
        { "const": "unknown" }
      ]
    },
    "device_opened": { "$ref": "#/$defs/triState" },
    "scan_a_started": { "type": "integer", "enum": [0, 1] },
    "scan_a_tck_emitted": { "type": "integer", "minimum": 0, "maximum": 591 },
    "scan_b_started": { "type": "integer", "enum": [0, 1] },
    "scan_b_tck_emitted": { "type": "integer", "minimum": 0, "maximum": 586 },
    "transport_closed": { "type": "integer", "enum": [0, 1] },
    "permit_consumed": { "$ref": "#/$defs/triState" },
    "operation_state": {
      "enum": [
        "PRELIVE", "PERMIT_VALIDATED", "RUNTIME_READY", "ENUMERATING",
        "DEVICE_SELECTED", "DEVICE_OPENED", "MPSSE_READY", "SCAN_A_ACTIVE",
        "SCAN_A_NAV_WRITE", "SCAN_A_BULK_WRITE", "SCAN_A_BULK_READ",
        "SCAN_A_FINAL_WRITE", "SCAN_A_FINAL_READ", "SCAN_A_EXIT_WRITE",
        "SCAN_A_COMPLETE", "SCAN_B_ACTIVE", "SCAN_B_NAV_WRITE",
        "SCAN_B_BULK_WRITE", "SCAN_B_BULK_READ", "SCAN_B_FINAL_WRITE",
        "SCAN_B_FINAL_READ", "SCAN_B_EXIT_WRITE", "SCAN_B_COMPLETE",
        "TRANSPORT_CLOSING", "TRANSPORT_CLOSED", "LOCAL_VALIDATED", "SIGNED_STAGED"
      ]
    },
    "close_from_state": {
      "oneOf": [
        { "type": "string", "enum": [
          "PRELIVE", "PERMIT_VALIDATED", "RUNTIME_READY", "ENUMERATING",
          "DEVICE_SELECTED", "DEVICE_OPENED", "MPSSE_READY", "SCAN_A_ACTIVE",
          "SCAN_A_NAV_WRITE", "SCAN_A_BULK_WRITE", "SCAN_A_BULK_READ",
          "SCAN_A_FINAL_WRITE", "SCAN_A_FINAL_READ", "SCAN_A_EXIT_WRITE",
          "SCAN_A_COMPLETE", "SCAN_B_ACTIVE", "SCAN_B_NAV_WRITE",
          "SCAN_B_BULK_WRITE", "SCAN_B_BULK_READ", "SCAN_B_FINAL_WRITE",
          "SCAN_B_FINAL_READ", "SCAN_B_EXIT_WRITE", "SCAN_B_COMPLETE"
        ] },
        { "type": "null" }
      ]
    },
    "publication_state": { "enum": ["NOT_STARTED", "SIGNED_STAGED", "PUBLISHING"] }
  },
  "$defs": {
    "triState": {
      "oneOf": [
        { "type": "integer", "enum": [0, 1] },
        { "const": "unknown" }
      ]
    }
  }
}

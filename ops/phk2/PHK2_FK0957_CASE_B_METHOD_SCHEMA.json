              }
            },
            "tms_vector": {
              "$ref": "#/$defs/bitVector"
            },
            "tdi_vector": {
              "$ref": "#/$defs/bitVector"
            },
            "cycle_count": {
              "type": "integer",
              "minimum": 1
            },
            "expected_transitions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/transition"
              }
            },
            "final_state": {
              "$ref": "#/$defs/tapState"
            },
            "expected_response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tdo_bits",
                "mask_bits",
                "bit_order",
                "sample_edge",
                "permitted_variation"
              ],
              "properties": {
                "tdo_bits": {
                  "$ref": "#/$defs/bitVector"
                },
                "mask_bits": {
                  "$ref": "#/$defs/bitVector"
                },
                "bit_order": {
                  "type": "string",
                  "minLength": 1
                },
                "sample_edge": {
                  "type": "string",
                  "minLength": 1
                },
                "permitted_variation": {
                  "type": [
                    "object",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "read_only": {
          "const": true
        },
        "read_only_proof": {
          "type": "object",
          "required": [
            "reference",
            "sha256",
            "approval_id"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "approval_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "physical_tck_correlation": {
          "type": "object",
          "required": [
            "method",
            "tck_measurement_point",
            "bscan_observation_point",
            "shared_capture_timebase",
            "capture_window",
            "acceptance_criteria"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "tck_measurement_point": {
              "type": "string",
              "minLength": 1
            },
            "bscan_observation_point": {
              "type": "string",
              "minLength": 1
            },
            "shared_capture_timebase": {
              "type": "string",
              "minLength": 1
            },
            "capture_window": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_criteria": {
              "type": "object",
              "minProperties": 1
            }
          },
          "additionalProperties": false
        },
        "acquisition_provenance": {
          "type": "object",
          "required": [
            "capture_backend_sha256",
            "capture_software_identity",
            "instrument_identity",
            "calibration_identity",
            "native_capture_format",
            "signing_role"
          ],
          "properties": {
            "capture_backend_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "capture_software_identity": {
              "type": "string",
              "minLength": 1
            },
            "instrument_identity": {
              "type": "string",
              "minLength": 1
            },
            "calibration_identity": {
              "type": "string",
              "minLength": 1
            },
            "native_capture_format": {
              "type": "string",
              "minLength": 1
            },
            "signing_role": {
              "const": "capture"
            }
          },
          "additionalProperties": false
        },
        "authorization_binding": {
          "type": "object",
          "required": [
            "operation",
            "card_scope",
            "case_id",
            "qualification_record_sha256",
            "loaded_image_sha256",
            "bridge_sha256",
            "method_sha256",
            "trust_root_sha256"
          ],
          "properties": {
            "operation": {
              "const": "PHK2_PHYSICAL_TCK_CLOSURE_CASE_B"
            },
            "card_scope": {
              "const": 1
            },
            "case_id": {
              "const": "33"
            },
            "qualification_record_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "loaded_image_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bridge_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "method_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "trust_root_sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "additionalProperties": false
        },
        "validity": {
          "type": "object",
          "required": [
            "issued_utc",
            "expires_utc",
            "target_session_nonce"
          ],
          "properties": {
            "issued_utc": {
              "type": "string",
              "format": "date-time"
            },
            "expires_utc": {
              "type": "string",
              "format": "date-time"
            },
            "target_session_nonce": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "evidence_contract": {
          "type": "object",
          "required": [
            "raw_tap_sha256",
            "raw_tck_capture_sha256",
            "raw_bscan_observation_sha256",
            "correlation_artifact_sha256",
            "journal_sha256",
            "journal_entry_sha256"
          ],
          "properties": {
            "raw_tap_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "raw_tck_capture_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "raw_bscan_observation_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "correlation_artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "journal_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "journal_entry_sha256": {
              "$ref": "#/$defs/sha256"
